        <mxCell id="legend" value="&lt;b style=&quot;font-size:12px;color:#14532d;&quot;&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#b45309;&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/span&gt; primary key &amp;nbsp; &lt;span style=&quot;color:#1d4ed8;&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/span&gt; foreign key &amp;nbsp; &lt;i&gt;italic name&lt;/i&gt; = unique&lt;br&gt;&lt;br&gt;&lt;b&gt;Crow&apos;s foot:&lt;/b&gt; fork = many &amp;nbsp; bar = exactly one &amp;nbsp; circle = optional (zero)&lt;br&gt;&lt;span style=&quot;color:#334155;&quot;&gt;&lt;b&gt;solid line&lt;/b&gt;&lt;/span&gt; = enforced foreign key&lt;br&gt;&lt;span style=&quot;color:#94a3b8;&quot;&gt;&lt;b&gt;dashed grey&lt;/b&gt;&lt;/span&gt; = audit link (recorded_by / user_id)&lt;br&gt;&lt;span style=&quot;color:#b45309;&quot;&gt;&lt;b&gt;dashed amber&lt;/b&gt;&lt;/span&gt; = indexed but not a FK (denormalised campus_id)&lt;br&gt;&lt;br&gt;Each line is labelled with the child FK column and ends on that exact row.&lt;br&gt;Snapshots freeze appliance, campus, office names and the applied rate/factor,&lt;br&gt;so later edits never rewrite history." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="60" y="1200" width="440" height="200" as="geometry"/></mxCell>
        <mxCell id="e1" value="role_id" style="edgeStyle=none;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.6;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=13;endSize=15;exitX=1;exitY=0.2727;entryX=0;entryY=0.2059;fontSize=9;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_roles" target="t_users"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="campus_id" style="edgeStyle=none;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.6;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=13;endSize=15;exitX=1;exitY=0.2368;entryX=0;entryY=0.6471;fontSize=9;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_campuses" target="t_users"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="campus_id" style="edgeStyle=none;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.6;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=13;endSize=15;exitX=1;exitY=0.2368;entryX=0;entryY=0.3256;fontSize=9;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_campuses" target="t_offices"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
